# NeonDB (feedback form + admin panel)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Public origin of this site. The OIDC redirect URI to register at your
# identity provider is ${APP_URL}/ap/auth/callback
APP_URL=http://localhost:3000

# OIDC login for /ap (Authorization Code + PKCE, confidential client)
OIDC_ISSUER=https://idp.example.com/realms/fin
OIDC_CLIENT_ID=fin-docs-admin
OIDC_CLIENT_SECRET=change-me
# Shown on the button: "Login with <OIDC_PROVIDER_NAME>" (default: SSO)
OIDC_PROVIDER_NAME=Example SSO
# OIDC_SCOPES=openid profile email
# Create unknown users as "member" (no access until an admin promotes them)
# on first login. When false, unknown users are rejected. Default: false
OIDC_JIT_PROVISIONING=false

# Optional: restrict the whole admin panel (/ap/**) to these IPv4/IPv6
# addresses or CIDR ranges (comma-separated). Unset = no IP restriction.
# ADMIN_IP_ALLOWLIST=203.0.113.10, 10.0.0.0/8, 2001:db8::/32

# Optional: raises the GitHub API rate limit for the build-time release lookup
# GITHUB_TOKEN=
